APP_NAME=Portfolio API
# Runtime environment; development enables API documentation.
APP_ENV=development

# Neon pooled URL, production only
DATABASE_URL=
# x-forwarded-for on Vercel, empty locally
CLIENT_IP_HEADER=

POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=portfolio_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

TOTP_ENC_KEY=change-me

# Gemini API key for chat and embeddings
GEMINI_API_KEY=
# Gemini model used to answer chat questions
GEMINI_CHAT_MODEL=
# Gemini model used to embed chat queries
GEMINI_EMBED_MODEL=
# Separate SELECT-only database URL for chat retrieval
CHAT_DATABASE_URL=
# Cloudflare Turnstile secret used by chat requests
TURNSTILE_SECRET_KEY=
# Salt used before hashing visitor IPs
IP_HASH_SALT=
# Maximum chat requests per day
CHAT_DAILY_LIMIT=
